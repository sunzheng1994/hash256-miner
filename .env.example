# 本机网关：复制为仓库根目录下的 .env 后填写（勿提交 .env）
#   cp .env.example .env
#
# --- 密钥（必填用于签名 / Worker 鉴权）---
HASH256_PRIVATE_KEY=0x
FLASHBOTS_AUTH_KEY=0x
REMOTE_MINER_API_KEY=

# 网关请求云端 Worker 时是否带 use_gpu=true（默认 true；仅本机调试可设 false）
HASH256_REMOTE_WORKER_USE_GPU=true

# 单次 PoW HTTP 的 max_batches 上限（网关会 min(body, 此值)）、HTTP 超时秒数
HASH256_REMOTE_POW_MAX_BATCHES=10000000
HASH256_REMOTE_POW_HTTP_TIMEOUT=3600

# --- 网页表单自动预填（可选；别名 HASH256_RPC / HASH256_CONTRACT 亦支持）---
HASH256_READ_RPC=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
HASH256_MINE_CONTRACT=0x你的Mine合约
# 不填则从 HASH256_PRIVATE_KEY 推导矿工地址
HASH256_MINER_ADDRESS=
HASH256_REMOTE_WORKER=https://你的ECS:8787/v1/pow-search

# Bundle 中继（不填则网页高级项默认主网 relay；Sepolia 请改为 relay-sepolia）
HASH256_FLASHBOTS_RELAY=https://relay.flashbots.net
